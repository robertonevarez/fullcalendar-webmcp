---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
---

<PageLayout
  site={{ title: "Protocol Tooling", description: config.description }}
  logo={{ text: "Protocol Tooling", href: "/" }}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "Protocol Tooling",
    description: "Protocol Tooling builds integrations that make existing web software available to AI agents through open standards such as WebMCP.",
    route: "/",
  }}
>
  <div class="mx-auto max-w-content px-6 pt-16 pb-24 lg:px-8">
    <header class="mb-14">
      <h1 class="text-4xl font-medium tracking-tighter text-foreground sm:text-5xl">
        Protocol Tooling
      </h1>
      <p class="mt-4 text-xl tracking-tight text-muted-foreground">
        Agent interfaces for the existing web.
      </p>
    </header>

    <div class="mt-8">
      <a
        href="/integrations/fullcalendar"
        class="group flex flex-col justify-between gap-1.5 border-b border-border py-4 text-inherit no-underline transition-opacity sm:flex-row sm:items-baseline sm:gap-6"
      >
        <span class="inline-flex items-center gap-1.5 text-base sm:text-lg font-medium text-foreground tracking-tight group-hover:opacity-75 transition-opacity">
          <span>FullCalendar WebMCP</span>
          <svg
            aria-hidden="true"
            class="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </span>
        <span class="text-base sm:text-lg text-muted-foreground tracking-tight">
          WebMCP tools for FullCalendar in React
        </span>
      </a>
    </div>
  </div>
</PageLayout>
