---
interface Props {
  site: { title: string };
  logo?: {
    svg?: string;
    light?: string;
    dark?: string;
    alt?: string;
    href?: string;
    text?: string;
  } | null;
}

const { logo } = Astro.props;
const brandHref = logo?.href ?? "/";
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
---

{
  !isHome && (
    <a
      class="inline-flex min-w-0 items-center font-medium text-base no-underline text-foreground transition-opacity hover:opacity-90"
      href={brandHref}
    >
      <span class="font-medium text-foreground">FullCalendar WebMCP</span>
    </a>
  )
}
