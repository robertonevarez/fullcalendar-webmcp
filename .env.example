# Protocol Tooling environment

# Absolute path to SQLite database file.
# Local default: ./data/protocoltooling.db
# Production (Render disk): /var/data/protocoltooling.db
DATABASE_PATH=

# Optional. When set, POST /api/demo/reset with
#   Authorization: Bearer <token>
# force-reseeds the demo database.
DEMO_RESET_TOKEN=
