{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "blume build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/demo",
      "destination": "/integrations/fullcalendar/demo",
      "permanent": true
    },
    {
      "source": "/demo/:path*",
      "destination": "/integrations/fullcalendar/demo/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/integrations/fullcalendar/demo",
      "destination": "https://protocoltooling-demo.vercel.app/integrations/fullcalendar/demo"
    },
    {
      "source": "/integrations/fullcalendar/demo/",
      "destination": "https://protocoltooling-demo.vercel.app/integrations/fullcalendar/demo"
    },
    {
      "source": "/integrations/fullcalendar/demo/:path*",
      "destination": "https://protocoltooling-demo.vercel.app/integrations/fullcalendar/demo/:path*"
    }
  ]
}
